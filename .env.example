# ─── MintBound environment ────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# --- Source chain: Ethereum Sepolia ------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- Creditcoin CC3 testnet ---------------------------------------------------
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# --- Keys ---------------------------------------------------------------------
# Deployer needs Sepolia ETH and CC3 testnet CTC.
DEPLOYER_PRIVATE_KEY=

# The worker is UNTRUSTED by design: it can censor, it cannot forge. It may safely
# be a different, low-value key from the deployer.
WORKER_PRIVATE_KEY=

# --- Attestcoin / USC ---------------------------------------------------------
# Verified live 2026-08-25: chainKey 1 = Ethereum Sepolia (chainId 11155111).
# chainKey 3 = Ethereum mainnet. These are Creditcoin-internal ids, NOT EVM chain ids.
SOURCE_CHAIN_KEY=1

# NOTE: the older `prover.usc-testnet.creditcoin.network` host does not resolve.
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network

# --- Protocol parameters ------------------------------------------------------
# Must comfortably exceed attestation latency (~44 Sepolia blocks, ~9 min) or minting
# freezes permanently through no fault of anyone. 200 blocks is ~40 minutes.
MAX_STALENESS_BLOCKS=200

# Anti-spam only, not a security parameter.
MIN_SNAPSHOT_GAP=5

# THE security parameter for the vault. Blocks between announcing a withdrawal and
# being allowed to execute it. Must exceed detection latency (~57 blocks worst case)
# with margin, or a custodian could exit before Creditcoin can prove they announced.
# 150 blocks = ~30 minutes. The deploy script refuses anything under 114.
WITHDRAWAL_DELAY_BLOCKS=150

# Risk discount on the reserve. 10000 = 100% (no discount). Bounded at 10000 on-chain.
HAIRCUT_BPS=10000

# Initial vault seed, in whole tokens.
SEED_AMOUNT=1000000

# --- Worker behaviour ---------------------------------------------------------
SNAPSHOT_INTERVAL_MS=300000
POLL_INTERVAL_MS=15000

# Record every real proof to deployments/replay-bundle.json so the dashboard's
# REPLAY mode can show genuine cryptographic data without the ~9 minute wait.
CAPTURE_PROOFS=true

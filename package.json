{
  "name": "mintbound",
  "version": "0.1.0",
  "private": true,
  "description": "Per-mint cryptographic authorization for wrapped and tokenized real-world assets on Creditcoin.",
  "license": "MIT",
  "workspaces": [
    "packages/contracts",
    "packages/cli",
    "packages/worker",
    "packages/dashboard"
  ],
  "scripts": {
    "build:contracts": "npm run build -w @mintbound/contracts",
    "test:contracts": "npm run test -w @mintbound/contracts",
    "worker": "npm run start -w @mintbound/worker",
    "dashboard": "npm run dev -w @mintbound/dashboard",
    "verify:live": "npm run verify:live -w @mintbound/worker",
    "postinstall": "node scripts/patch-hardhat-reporter.mjs",
    "test:invariant": "npm run test:invariant -w @mintbound/contracts",
    "cli": "npm run dev -w mintbound-cli --",
    "status": "npm run dev -w mintbound-cli -- status",
    "attack:live": "npm run dev -w mintbound-cli -- attack",
    "verify:source": "npm run verify:source -w @mintbound/contracts",
    "coverage": "npm run coverage -w @mintbound/contracts",
    "claims": "npm run dev -w mintbound-cli -- claims",
    "publish:cli": "npm publish -w mintbound-cli --access public"
  }
}
